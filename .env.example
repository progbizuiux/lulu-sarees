# Copy this file to .env.local and fill in the values.
# Restart `npm run dev` after changing any of these.

# --- ERP shop API (server only) ---
# Address of the ERP API, without a trailing slash. Sent by the ERP team.
# Example: https://erp.example.com
ERP_API_URL=
# The shop key. Sent by the ERP team. Never put it in a NEXT_PUBLIC_ variable or in browser code.
ERP_STORE_KEY=

# --- Site ---
# true  = use the demo data in data/products.js (no backend needed)
# false = call the real API
NEXT_PUBLIC_USE_MOCKS=true

# Old setting from before the ERP handover. Leave empty.
NEXT_PUBLIC_API_URL=

# How long to wait for the API before giving up (milliseconds).
NEXT_PUBLIC_API_TIMEOUT=15000

# Fake delay for mock responses, so loaders can be seen and tested (milliseconds).
NEXT_PUBLIC_MOCK_DELAY=400

# Login cookie name. Turns on middleware.js (private pages redirect to login on the server).
# The ERP's login cookie is pb_store. Leave empty while mocks are on.
AUTH_COOKIE_NAME=

# The site's own address. Used for SEO: canonical links, sitemap, link previews. Must be set on live.
NEXT_PUBLIC_SITE_URL=

# Comma-separated hosts the product photos come from. Next.js only optimises images from these.
IMAGE_HOSTNAMES=

# false = robots.txt blocks search engines (use on staging). Leave unset on the live site.
NEXT_PUBLIC_ALLOW_INDEXING=
